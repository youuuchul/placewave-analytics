[
  {
    "name": "request_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "검색 요청 ID"
  },
  {
    "name": "requested_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
